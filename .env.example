# Copy this file to .env. Keys stay on the server; never use VITE_ for a key.
# preview = authored sample activities, ollama = local open model, backboard = hosted model
MODEL_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
BACKBOARD_API_KEY=
BACKBOARD_PROVIDER=
BACKBOARD_MODEL_NAME=
# Only enable after checking this exact model's open-weight model card.
BACKBOARD_OPEN_WEIGHT_CONFIRMED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Usage caps are request/character limits, not guaranteed dollar spending limits.
MAX_MODEL_CALLS_PER_DAY=20
MAX_MODEL_CALLS_TOTAL=60
MAX_VOICE_CHARACTERS_PER_DAY=3000
MAX_VOICE_CHARACTERS_TOTAL=10000
MAX_REQUESTS_PER_HOUR=12
RUNTIME_DIR=.runtime
